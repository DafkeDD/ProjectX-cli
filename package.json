{
  "name": "projectx-cli",
  "version": "0.4.0",
  "description": "Interactieve CLI die stap voor stap een project opzet in de huidige map.",
  "type": "module",
  "bin": {
    "projectx-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "preinstall": "node scripts/no-global.cjs",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": ["cli", "scaffold", "nextjs", "tailwindcss"],
  "author": "DafkeDD",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
